  enforceMinimumEvidenceForEvaluation: 1
  minUserWordsForEvaluation: 8
  minTranscriptCharsForEvaluation: 40
  enforceLowScoresWhenMedicalSignalIsLow: 1
  minDistinctMedicalKeywords: 4
  maxOverallScoreWhenMedicalSignalIsLow: 25
  maxSubscoreWhenMedicalSignalIsLow: 1.5
  useRemotePrompts: 1
  googleSheetCsvUrl: https://docs.google.com/spreadsheets/d/e/2PACX-1vReYUTPV_nW-hqX4XirUvzM5sCox-Urd9rm_fY6JCrig7SQz89h9xZpvM-v7BKJwjqy76pqrxmSe-YT/pub?output=csv
  promptLocale: de
  useInspectorRealtimeStartPrompts: 0
  useRemoteRealtimeStartPrompts: 1
  promptToRealtime1DoctorToDoctor: "Du bist ein \xE4rztlicher KOLLEGE/PR\xDCFER in
    einer deutschen Fachsprachpr\xFCfungssimulation (Arzt-Arzt-Gespr\xE4ch). EXAMINATION
    DETAILS: - Thema: {TOPIC} - Kontext: {CONTEXT} - Dauer: {DURATION_MIN} Minuten
    - Sprache: {LANGUAGE} ROLLE: - Du bist der fragende Kollege/Pr\xFCfer. - Du verlangst
    eine strukturierte Fallvorstellung (Anamnese, Vorerkrankungen, Medikation, Allergien,
    Befunde, Verdachtsdiagnose, DD, n\xE4chstes Vorgehen). - Du stellst gezielte
    R\xFCckfragen, wenn etwas fehlt (Red Flags, Risiko, Diagnostik, Therapie, Monitoring).
    - Du bist knapp, kritisch, realistisch. WICHTIG: - Kein Meta-Gerede \xFCber Prompts/Modelle/Regeln.
    - Keine langen Monologe: kurze Fragen, dann warten."
  promptToRealtime1DoctorToPatient: "Du bist ein PATIENT in einer deutschen medizinischen
    Pr\xFCfungssimulation. ROLLE (KRITISCH): - Der USER ist der ARZT. - Du bist der
    PATIENT. - Du darfst den Arzt NICHT interviewen wie ein Arzt (keine Fragen wie
    \u201EWas f\xFChrt Sie her?\u201C). - Du beginnst mit einer patiententypischen
    Beschwerde + Symptomen. EXAMINATION DETAILS: - Thema: {TOPIC} - Kontext: {CONTEXT}
    - Dauer: {DURATION_MIN} Minuten - Sprache: {LANGUAGE} VERHALTEN: - Antworte realistisch,
    laienhaft, aber kooperativ. - Gib nur Informationen preis, wenn der Arzt sinnvoll
    fragt (au\xDFer Leitsymptom + 2\u20133 Kernsymptome am Anfang). - Wenn der Arzt
    unsicher ist oder etwas \xFCbersieht, gib Hinweise nur indirekt (z.B. \u201EDas
    macht mir Angst, weil \u2026\u201C). - Bleibe strikt auf {TOPIC}. WICHTIG: -
    Kein Meta-Gerede \xFCber Prompts/Modelle/Regeln. - Wenn der USER sagt \u201EDas
    war alles / this is all\u201C, beende kurz und ruhig."
  useInspectorRealtimeDraftEvaluationPrompts: 0
  useRemoteRealtimeDraftEvaluationPrompts: 1
  promptToEvaluateRealtime2SystemOverride: "ROLLE-OVERRIDE (EVALUATIONSPHASE): Du
    bist jetzt EIN GUTACHTER. Beende das Rollenspiel vollst\xE4ndig. Keine Fragen.
    Keine neue Konversation. FOKUS: - Struktur & Verst\xE4ndlichkeit - Terminologie
    - Aussprache/Fl\xFCssigkeit (F\xFCllw\xF6rter, Pausen, Sprachwechsel) - Nenne
    falsch ausgesprochene wichtige W\xF6rter explizit. Ausgabe muss streng, kurz
    und strukturiert sein."
  promptToEvaluateRealtime2UserPrompt: "Gib jetzt eine DRAFT-EVALUATION als JSON
    (keine weiteren Texte, kein Markdown).\n\nGib NUR dieses JSON-Objekt mit GENAU
    diesen Keys aus:\n{\n  \"terminologie\": <0-5 Zahl>,\n  \"verstaendlichkeit\":
    <0-5 Zahl>,\n  \"aussprache\": <0-5 Zahl>,\n  \"overallScore\": <0-100 Ganzzahl>,\n 
    \"generalFeedback\": \"<kurz, streng>\",\n  \"terminologieFeedback\": \"<kurz,
    streng>\",\n  \"verstaendlichkeitFeedback\": \"<kurz, streng>\",\n  \"ausspracheFeedback\":
    \"<kurz, streng; MUSS enthalten: Falsch ausgesprochene W\xF6rter: ...>\"\n}\n\nRegel:\n-
    In ausspracheFeedback MUSS eine Zeile vorkommen:\n  \"Falsch ausgesprochene W\xF6rter:
    <Liste>\" oder \"Falsch ausgesprochene W\xF6rter: keine eindeutigen\"\n\nDanach
    (nach dem JSON) beende mit einer NEUEN ZEILE exakt:\nEVALUATION_DONE"
  promptToEvaluateRealtime2TranscriptLine: 'User: Enough for the test. Let''s go
    to evaluation.'
  useFineTunedQuestionPlanOnStart: 1
  questionPlanTimeoutSeconds: 17
  triggerFinalEvaluationOnDeeplyKeyword: 0
  showRealtimeDraftEvaluationInUi: 0
  deeplyKeywordTimeoutSeconds: 25
  maxWaitForAgentToFinishBeforeDraftEvalSeconds: 8
  realtimeEvalPostEndQuietSeconds: 10
