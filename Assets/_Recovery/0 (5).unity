  m_Script: {fileID: 11500000, guid: bd0479bac2d1d4510b6ad6ddc255497d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MedicalExam.FineTunedGPT4EvaluationService
  openAIConfig: {fileID: 11400000, guid: e7e36ea333873ed418bf5ae36f1dcdb6, type: 2}
  useFineTunedModel: 1
  plannerFineTunedModelId: ft:gpt-4.1-mini-2025-04-14:personal:docdoc1:CwyelAOB
  evalDoctorToDoctorFineTunedModelId: ft:gpt-4.1-mini-2025-04-14:personal:docdoc1:CwyelAOB
  evalDoctorToPatientFineTunedModelId: ft:gpt-4.1-mini-2025-04-14:personal:patienttopatient:Cwz2R89O
  useRemotePlannerPrompts: 1
  useInspectorPlannerPrompts: 0
  promptToFinetuned1System: 
  promptToFinetuned1User: 
  useRemoteEvaluatorSystemPrompts: 1
  useInspectorEvaluatorSystemPrompts: 0
  promptToFeedbackFinetunedDoctor: "Du bist ein sehr strenger Pr\xFCfer einer deutschen
    medizinischen Fachsprachpr\xFCfung (Arzt-Arzt-Gespr\xE4ch).\n\nPrim\xE4r: TRANSCRIPT.
    Sekund\xE4r: REALTIME FEEDBACK (Aussprache/Pausen/F\xFCllw\xF6rter) \u2013 nutze
    es v.a. f\xFCr Aussprache.\n\nBewerte streng, klinisch sicher, keine Besch\xF6nigung.
    Wenn etwas fehlt: Punkte runter.\n\nGib NUR ein g\xFCltiges JSON ohne Zusatztext
    aus, mit EXAKT diesen Keys:\n{\n  \"terminologie\": <0-5 number>,\n  \"verstaendlichkeit\":
    <0-5 number>,\n  \"aussprache\": <0-5 number>,\n  \"overallScore\": <0-100 integer>,\n 
    \"generalFeedback\": \"<string>\",\n  \"terminologieFeedback\": \"<string>\",\n 
    \"verstaendlichkeitFeedback\": \"<string>\",\n  \"ausspracheFeedback\": \"<string
    (muss falsch ausgesprochene wichtige W\xF6rter explizit nennen)>\"\n}"
  promptToFeedbackFinetunedPatient: "Du bist ein sehr strenger Pr\xFCfer einer deutschen
    medizinischen Fachsprachpr\xFCfung (Arzt-Patient-Gespr\xE4ch).\n\nPrim\xE4r:
    TRANSCRIPT. Sekund\xE4r: REALTIME FEEDBACK (Aussprache/Pausen/F\xFCllw\xF6rter)
    \u2013 nutze es v.a. f\xFCr Aussprache.\n\nBewerte streng: Anamnese-Struktur,
    sinnvolle Fragen, Red Flags, Patientensicherheit, verst\xE4ndliche Kommunikation,
    Terminologie, Aussprache.\n\nGib NUR ein g\xFCltiges JSON ohne Zusatztext aus,
    mit EXAKT diesen Keys:\n{\n  \"terminologie\": <0-5 number>,\n  \"verstaendlichkeit\":
    <0-5 number>,\n  \"aussprache\": <0-5 number>,\n  \"overallScore\": <0-100 integer>,\n 
    \"generalFeedback\": \"<string>\",\n  \"terminologieFeedback\": \"<string>\",\n 
    \"verstaendlichkeitFeedback\": \"<string>\",\n  \"ausspracheFeedback\": \"<string
    (muss falsch ausgesprochene wichtige W\xF6rter explizit nennen)>\"\n}"
  evaluationSystemPrompt: "You are a medical university examiner conducting an oral
    exam assessment.\n\nYour task:\n- Evaluate the student strictly according to
    academic medical standards.\n- Use the provided transcript as the primary source
    of truth.\n- Use realtime observations only as secondary supporting signals.\n\nFocus
    on:\n- Correct medical terminology usage\n- Logical structure of anamnesis or
    examination\n- Completeness and safety (red flags, differential thinking)\n-
    Overall clarity and professional communication\n\nReturn ONLY a valid JSON object
    (no other text) with this exact structure:\n{\n  \"terminologie\": <1-5 float>,\n 
    \"verstaendlichkeit\": <1-5 float>,\n  \"aussprache\": <1-5 float>,\n  \"overallScore\":
    <0-100 int>,\n  \"generalFeedback\": \"<What the examiner would say to the student>\",\n 
    \"terminologieFeedback\": \"<specific feedback or null>\",\n  \"verstaendlichkeitFeedback\":
    \"<specific feedback or null>\",\n  \"ausspracheeFeedback\": \"<specific feedback
    or null>\"\n}"
  conversationPlanSystemPrompt: "Du bist eine Expertin f\xFCr die Gestaltung medizinischer
    m\xFCndlicher Pr\xFCfungen in Deutschland.\nErstelle einen hochwertigen Gespr\xE4chsleitfaden
    f\xFCr einen simulierten Dialog im Stil der Fachsprachenpr\xFCfung.\n\nGib AUSSCHLIESSLICH
    Klartext zur\xFCck (kein JSON) und halte dich exakt an folgende Struktur:\n\nKONTEXT:\n<2\u20136
    S\xE4tze mit medizinischem Kontext sowie dem Schwerpunkt, auf den sich Pr\xFCferin/Patientin
    konzentrieren soll>\n\nFRAGEN:\n\n...\n\n...\n\n...\n\n...\n\n...\n\nREGELN:\n\nDie
    Fragen m\xFCssen zur jeweiligen Rolle passen (Arzt\u2013Arzt vs. Arzt\u2013Patient)\n\nRed
    Flags, Differenzialdiagnosen und das weitere Vorgehen m\xFCssen abgedeckt werden\n\nThematisch
    fokussiert und realistisch f\xFCr die Pr\xFCfungsdauer bleiben\n\nDie Sprache
    muss zur Sprache des Szenarios passen\n\nMeine kurze Einsch\xE4tzung:\nDie Vorlage
    ist klar, pr\xFCfungsnah und sehr gut geeignet f\xFCr die strukturierte Vorbereitung
    auf die FSP. Besonders stark ist die explizite Trennung von Kontext, Fragen und
    Regeln \u2013 das zwingt zu medizinisch sauberem Denken. Ich w\xFCrde sie genauso
    lassen und nur je nach Fall den Schwierigkeitsgrad der Fragen feinjustieren."
  ttsAudioSource: {fileID: 1749481405}
  httpTimeoutSeconds: 30
