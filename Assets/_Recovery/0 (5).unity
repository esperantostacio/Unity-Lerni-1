  m_EditorClassIdentifier: Assembly-CSharp::MedicalExam.MedicalExamManager
  currentScenario: {fileID: 11400000, guid: 00c8898eeb403d04d99d1acc77645116, type: 2}
  useRemoteScenario: 0
